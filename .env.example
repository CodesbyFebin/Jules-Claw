JULES_API_KEY=your_jules_api_key_here
OPEN_JULES_USERNAME=admin
OPEN_JULES_PASSWORD=replace_with_a_random_secret_16_chars_min
# Strictly local single-user mode only. Hosted/multi-user requests fail closed.
# JULES_DEPLOYMENT_MODE=local-single-operator
# DATABASE_URL=postgresql://user:password@host:5432/openjules
# GATEWAY_BASE_URL=https://your-gateway.example/v1
# GATEWAY_API_KEY=your_gateway_api_key
# Local-first fallback to an OpenAI-compatible loopback inference API (e.g. Ollama /v1).
# JULES_LOCAL_LLM_URL=http://127.0.0.1:11434/v1
# JULES_LOCAL_LLM_MODEL=qwen2.5:7b
# JULES_MEMORY_PATH=.jules-state/memory.sqlite
# JULES_APPROVAL_DB_PATH=.jules-state/approvals.sqlite
# JULES_APPROVED_EXECUTION_ENABLED=false
# GITHUB_TOKEN=github_read_only_token_for_private_pr_evidence
# VERIFIER_IMAGE=open-jules-verifier:local
# Six real advisory LLM calls (disabled until explicitly enabled):
# SWARM_ENABLED=true
# SWARM_MODEL_ARCHITECT=model-id
# SWARM_MODEL_CODER=model-id
# SWARM_MODEL_DEBUGGER=model-id
# SWARM_MODEL_SECURITY=model-id
# SWARM_MODEL_VERIFIER=model-id
# SWARM_MODEL_MANAGER=model-id
# GATEWAY_MODELS=qwen-coder,deepseek-coder
# GITHUB_ALLOWED_REPOS=CodesbyFebin/Jules-Claw
# Optional NVIDIA SkillSpector static scan (disabled by default)
# NVIDIA_SKILL_SCAN_ENABLED=true
# NVIDIA_SKILL_ROOT=/absolute/path/to/approved-candidate-skills
# SKILLSPECTOR_BINARY=/usr/local/bin/skillspector
# Reserved for a future OpenShell execution adapter; does not enable sandbox execution:
# NVIDIA_OPENSHELL_ENABLED=false
# Optional: use only a pre-provisioned, policy-controlled OpenShell sandbox.
# OPENSHELL_EXEC_ENABLED=false
# OPENSHELL_SANDBOX_NAME=jules-verifier
# Enables only the fixed local skill preflight; does not install skills.
# JULES_SKILL_PREFLIGHT_ENABLED=false
# Enables read-only retrieval of pinned candidate Markdown from the fixed
# GitHub raw host. Does not install/approve/execute remote instructions.
# JULES_PINNED_SKILL_FETCH_ENABLED=false
